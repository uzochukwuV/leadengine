# ===========================================
# Shopify Cold Email Agent - Environment
# ===========================================

# LLM Provider (OpenAI recommended for best results)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-... # Optional - for Claude models

# ===========================================
# Caspian Messaging (https://www.trycaspianai.com/)
# ===========================================
CASPIAN_API_KEY=cas_... # Get from trycaspianai.com

# Caspian Email Channel (configure username after getting API key)
# CASPIAN_EMAIL_USERNAME=scout # Ask Caspian what email address you want

# ===========================================
# Email Provider Configuration
# ===========================================
# Choose one: 'resend', 'sendgrid', 'smtp', 'ses'
EMAIL_PROVIDER=resend

# Resend (Recommended)
RESEND_API_KEY=re_...

# SendGrid (Alternative)
SENDGRID_API_KEY=SG....

# SMTP Configuration (Alternative)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=outreach@example.com

# AWS SES (Alternative)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
SES_FROM_EMAIL=outreach@example.com

# ===========================================
# Inbox Access (for checking replies)
# ===========================================
# Gmail API
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/callback
GMAIL_REFRESH_TOKEN=...

# Or IMAP (simpler but less features)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password

# ===========================================
# Lead Data Enrichment APIs (optional)
# ===========================================
APOLLO_API_KEY=...           # For contact discovery
HUNTER_API_KEY=...           # For email finding
CLEARBIT_API_KEY=...         # For company enrichment
BUILTWITH_API_KEY=...        # For technology detection

# ===========================================
# Storage (optional - defaults to local file)
# ===========================================
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info  # debug, info, warn, error

# ===========================================
# Campaign Defaults
# ===========================================
DEFAULT_FROM_NAME=Your Name
DEFAULT_REPLY_TO=reply@example.com
CAMPAIGN_DAILY_LIMIT=50  # Max emails per day
